# Contraseña del panel /admin (OBLIGATORIO cambiarla)
ADMIN_PASSWORD=

# IA (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# WhatsApp Cloud API (developers.facebook.com → tu app → WhatsApp → Configuración de la API)
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=elegi-una-palabra-secreta
# App secret (Configuración de la app → Básica). Valida que los mensajes vengan de Meta.
WA_APP_SECRET=

# Carpeta donde se guarda la base de datos. En Railway: montá un Volume en /data
DATA_DIR=/data
